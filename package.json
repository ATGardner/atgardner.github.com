  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/polyfill": "^7.8.7",
    "@babel/preset-env": "^8.0.0",
    "@babel/eslint-parser": "^8.0.0",
    "babel-loader": "^10.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^17.7.0",
    "ol-wrapper": "^0.7.2",
    "prettier": "^3.0.0",
